# Copy to .env.local for local development, or .env.production before a
# per-environment `next build` (NEXT_PUBLIC_* values are inlined at build
# time, so test/beta/prod each need their own build with their own values —
# see PROGRESS.md / ARCHITECTURE.md "Deployment" section).

# Backend API base URL (NestJS, global prefix /api). No trailing slash.
# test: https://test.operatora.ai/api
# beta: https://beta.operatora.ai/api
# prod: https://operatora.ai/api
NEXT_PUBLIC_API_BASE_URL=https://test.operatora.ai/api

# Socket.io origin (gateway is mounted at "/", not under /api). Optional —
# if unset it is derived from NEXT_PUBLIC_API_BASE_URL by stripping "/api".
# NEXT_PUBLIC_WS_URL=https://test.operatora.ai
